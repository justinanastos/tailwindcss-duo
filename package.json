{
  "name": "tailwindcss-duo",
  "version": "0.1.1",
  "description": "Tailwind CSS 4 plugin for the iPhone Duo: posture and viewport-segment variants, segment layout helpers, safe-area padding. Pure CSS.",
  "license": "MIT",
  "style": "index.css",
  "main": "index.css",
  "exports": {
    ".": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./index.css": "./index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "index.css"
  ],
  "keywords": [
    "tailwindcss",
    "tailwindcss-plugin",
    "iphone-duo",
    "foldable",
    "device-posture",
    "viewport-segments",
    "safe-area"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "test": "node --test",
    "demo": "cd demo && npm install && npm run build && node server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinanastos/tailwindcss-duo.git"
  },
  "homepage": "https://github.com/justinanastos/tailwindcss-duo#readme",
  "author": "Justin Anastos"
}
